{
  "name": "ai-runtime-platform",
  "version": "0.3.0-m0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "setup": "npm run build -w @ai-runtime/contracts && npm run db:generate && node scripts/setup-local.mjs",
    "dev": "node scripts/dev.mjs",
    "db:start": "node scripts/setup-local.mjs --db-only",
    "db:stop": "node scripts/setup-local.mjs --stop",
    "db:migrate": "node scripts/database/migrate.mjs",
    "db:inspect": "tsx apps/api/src/cli/inspect.ts",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "typecheck": "npm run db:generate && npm run build -w @ai-runtime/contracts && npm run typecheck --workspaces --if-present && npm run build -w @ai-runtime/api && npm run typecheck:tests",
    "contracts:export": "npm run build -w @ai-runtime/contracts && tsx scripts/export-contracts.ts",
    "contracts:check": "npm run build -w @ai-runtime/contracts && tsx scripts/export-contracts.ts --check",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "npm run build -w @ai-runtime/contracts && tsx --test packages/contracts/test/contracts.test.ts",
    "test:integration": "npm run build -w @ai-runtime/api && tsx --test apps/api/test/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run architecture:check && npm run contracts:boundary && npm run serialization:check && npm run ui:check && npm run typecheck && npm test && npm run test:unit && npm run test:integration && npm run test:web && npm run test:cdc && npm run contracts:check && npm run build && npm run web:bundle-check && npm run docs:check",
    "db:generate": "prisma generate",
    "test:unit": "tsx --test apps/api/test/unit/*.test.ts && node --test scripts/test/*.test.mjs",
    "lint": "eslint apps packages scripts config tests playwright.config.ts prisma.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "architecture:check": "node scripts/check-architecture.mjs",
    "ui:check": "node scripts/check-ui-tokens.mjs",
    "typecheck:tests": "tsc -p apps/api/tsconfig.test.json && tsc -p packages/contracts/tsconfig.test.json && tsc -p tsconfig.tools.json && npm run typecheck:tests -w @ai-runtime/web && tsc -p tests/cdc/tsconfig.json --noEmit",
    "db:format": "prisma format",
    "test:web": "node --conditions=react-server --import tsx --test apps/web/test/*.test.ts",
    "web:bundle-check": "node scripts/check-web-bundle.mjs",
    "test:web:redis": "node --conditions=react-server --import tsx --test apps/web/test/redis-store.integration.ts",
    "cdc:consumer": "node --conditions=react-server --import tsx tests/cdc/consumer.ts",
    "cdc:provider": "node --conditions=react-server --import tsx tests/cdc/provider.ts",
    "test:cdc": "npm run build -w @ai-runtime/contracts && npm run build -w @ai-runtime/api && npm run cdc:consumer && npm run cdc:provider",
    "cdc:broker-proof": "node --conditions=react-server --import tsx tests/cdc/broker-proof.ts",
    "cdc:publish": "node --conditions=react-server --import tsx tests/cdc/delivery.ts publish",
    "cdc:verify:broker": "node --conditions=react-server --import tsx tests/cdc/provider.ts --broker",
    "cdc:can-i-deploy": "node --conditions=react-server --import tsx tests/cdc/delivery.ts can-i-deploy",
    "cdc:record-deployment": "node --conditions=react-server --import tsx tests/cdc/delivery.ts record-deployment",
    "contracts:boundary": "node scripts/check-http-contracts.mjs",
    "serialization:check": "node scripts/check-serialization.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pact-foundation/pact": "17.1.4",
    "@pact-foundation/pact-cli": "18.1.2",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
