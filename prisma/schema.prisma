generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/infrastructure/database/generated"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["m0", "control"]
}

model Application {
  id          String          @id @db.Text
  displayName String          @map("display_name") @db.Text
  tokenSha256 String          @unique(map: "applications_token_sha256_key") @map("token_sha256") @db.Char(64)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  profiles    Profile[]
  checks      ContractCheck[]

  @@map("applications")
  @@schema("m0")
}

model Profile {
  applicationId String      @map("application_id") @db.Text
  profileRef    String      @map("profile_ref") @db.Text
  definition    Json        @db.JsonB
  digest        String      @db.Char(64)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([applicationId, profileRef])
  @@map("profiles")
  @@schema("m0")
}

model ContractCheck {
  id              String      @id @db.Uuid
  applicationId   String      @map("application_id") @db.Text
  idempotencyKey  String      @map("idempotency_key") @db.Text
  requestDigest   String      @map("request_digest") @db.Char(64)
  contractVersion String      @map("contract_version") @db.Text
  kind            String      @db.Text
  valid           Boolean
  requestSummary  Json        @map("request_summary") @db.JsonB
  report          Json        @db.JsonB
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  application     Application @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([applicationId, idempotencyKey], map: "contract_checks_application_id_idempotency_key_key")
  @@index([applicationId, createdAt(sort: Desc), id(sort: Desc)], map: "contract_checks_scope_time")
  @@map("contract_checks")
  @@schema("m0")
}

/// Read-only provenance of the pre-Prisma migration. Never erase applied history.
model LegacySchemaMigration {
  version   String   @id @db.Text
  checksum  String   @db.Text
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
  @@schema("m0")
}

enum ControlStatus {
  ENABLED
  DISABLED

  @@schema("control")
}

enum ConnectionSharingMode {
  DEDICATED
  SHARED

  @@schema("control")
}

enum CredentialResidency {
  CENTRAL
  RUNNER_LOCAL

  @@schema("control")
}

enum DispatchEnvelopeState {
  STAGED
  COMMITTED
  CONSUMED
  DELETE_PENDING
  EXPIRED

  @@schema("control")
}

model ControlApplication {
  revision                 Int                 @default(1)
  id                       String              @id @db.Text
  displayName              String              @map("display_name") @db.Text
  environment              String              @db.Text
  keycloakClientId         String              @unique(map: "applications_keycloak_client_id_key") @map("keycloak_client_id") @db.Text
  gatewayMaxConcurrency    Int                 @default(100) @map("gateway_max_concurrency")
  gatewayRequestsPerMinute Int                 @default(600) @map("gateway_requests_per_minute")
  status                   ControlStatus       @default(ENABLED)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  bindings                 CredentialBinding[]

  profileRevisions  ProfileRevision[]
  budgets           BudgetAccount[]
  executions        Execution[]
  events            OutboxEvent[]
  audit             AuditEntry[]
  dispatchEnvelopes DispatchEnvelope[]

  @@map("applications")
  @@schema("control")
}

model AiConnection {
  revision                 Int                   @default(1)
  id                       String                @id @db.Text
  displayName              String                @map("display_name") @db.Text
  provider                 String                @db.Text
  authMode                 String                @map("auth_mode") @db.Text
  environment              String                @db.Text
  sharingMode              ConnectionSharingMode @map("sharing_mode")
  quotaGroupRef            String?               @map("quota_group_ref") @db.Text
  gatewayMaxConcurrency    Int                   @default(100) @map("gateway_max_concurrency")
  gatewayRequestsPerMinute Int                   @default(600) @map("gateway_requests_per_minute")
  status                   ControlStatus         @default(ENABLED)
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  credentials              CredentialInstance[]
  bindings                 CredentialBinding[]
  providerInvocations      ProviderInvocation[]

  profiles         ProfileRevision[] @relation("PrimaryProfileConnection")
  fallbackProfiles ProfileRevision[] @relation("FallbackProfileConnection")

  @@map("ai_connections")
  @@schema("control")
}

model CredentialInstance {
  revision     Int                 @default(1)
  id           String              @id @db.Text
  connectionId String              @map("connection_id") @db.Text
  secretRef    String?             @map("secret_ref") @db.Text
  residency    CredentialResidency
  runnerRef    String?             @map("runner_ref") @db.Text
  status       ControlStatus       @default(ENABLED)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  connection   AiConnection        @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  runner RunnerNode? @relation(fields: [runnerRef], references: [id], onDelete: Restrict)

  @@index([connectionId, status], map: "credential_instances_connection_status")
  @@map("credential_instances")
  @@schema("control")
}

model CredentialBinding {
  revision      Int                @default(1)
  id            String             @id @db.Uuid
  applicationId String             @map("application_id") @db.Text
  connectionId  String             @map("connection_id") @db.Text
  profileRef    String?            @map("profile_ref") @db.Text
  status        ControlStatus      @default(ENABLED)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  application   ControlApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  connection    AiConnection       @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([applicationId, connectionId, profileRef], map: "credential_bindings_scope_key")
  @@index([applicationId, status], map: "credential_bindings_application_status")
  @@map("credential_bindings")
  @@schema("control")
}

model ProfileRevision {
  id                      String   @id @db.Uuid
  applicationId           String   @map("application_id")
  profileRef              String   @map("profile_ref")
  revision                Int
  connectionId            String   @map("connection_id")
  capability              String
  providerAdapter         String   @default("UNCONFIGURED") @map("provider_adapter")
  model                   String   @default("UNCONFIGURED")
  fallbackConnectionId    String?  @map("fallback_connection_id")
  fallbackProviderAdapter String?  @map("fallback_provider_adapter")
  fallbackModel           String?  @map("fallback_model")
  maxOutputTokens         Int      @default(2048) @map("max_output_tokens")
  timeoutMs               Int      @default(30000) @map("timeout_ms")
  streaming               Boolean  @default(false)
  holdUnits               BigInt   @map("hold_units")
  accountIds              String[] @map("account_ids")
  digest                  String   @db.Char(64)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application        ControlApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  connection         AiConnection       @relation("PrimaryProfileConnection", fields: [connectionId], references: [id], onDelete: Restrict)
  fallbackConnection AiConnection?      @relation("FallbackProfileConnection", fields: [fallbackConnectionId], references: [id], onDelete: Restrict)
  aliases            ProfileAlias[]
  executions         Execution[]
  dispatchEnvelopes  DispatchEnvelope[]

  @@unique([id, applicationId])
  @@unique([applicationId, profileRef, revision])
  @@map("profile_revisions")
  @@schema("control")
}

model ProfileAlias {
  applicationId String  @map("application_id")
  profileRef    String  @map("profile_ref")
  revision      Int
  enabled       Boolean @default(true)

  profile ProfileRevision @relation(fields: [applicationId, profileRef, revision], references: [applicationId, profileRef, revision], onDelete: Restrict)
  version Int             @default(1)

  @@id([applicationId, profileRef])
  @@map("profile_aliases")
  @@schema("control")
}

model BudgetAccount {
  id            String  @id
  applicationId String? @map("application_id")
  quotaGroupRef String? @map("quota_group_ref")
  unit          String
  period        String
  limitUnits    BigInt  @map("limit_units")
  heldUnits     BigInt  @default(0) @map("held_units")
  postedUnits   BigInt  @default(0) @map("posted_units")
  revision      Int     @default(1)

  application  ControlApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  projection   BudgetProjection?

  @@map("budget_accounts")
  @@schema("control")
}

model Execution {
  runnerAssignments    RunnerAssignment[]
  runnerEvidence       RunnerEvidence[]
  toolEffects          ToolEffect[]
  assignmentGeneration Int                  @default(0) @map("assignment_generation")
  coordinationEpoch    Int                  @default(1) @map("coordination_epoch")
  id                   String               @id @db.Uuid
  applicationId        String               @map("application_id")
  idempotencyKey       String               @map("idempotency_key")
  requestDigest        String               @map("request_digest") @db.Char(64)
  admissionSource      String               @default("CONTROL_PLANE") @map("admission_source")
  profileRevisionId    String               @map("profile_revision_id") @db.Uuid
  profileSnapshot      Json                 @map("profile_snapshot")
  status               String               @default("ACCEPTED")
  revision             Int                  @default(1)
  cancelRequestedAt    DateTime?            @map("cancel_requested_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  attempts             Attempt[]
  reservations         Reservation[]
  observations         UsageObservation[]
  ledger               LedgerEntry[]
  artifacts            ArtifactMetadata[]
  providerInvocations  ProviderInvocation[]
  result               ExecutionResult?
  dispatchEnvelope     DispatchEnvelope?
  statusReason         String?              @map("status_reason")
  completedAt          DateTime?            @map("completed_at") @db.Timestamptz(6)

  application ControlApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  profile     ProfileRevision    @relation(fields: [profileRevisionId, applicationId], references: [id, applicationId], onDelete: Restrict)

  @@unique([applicationId, idempotencyKey])
  @@unique([id, applicationId])
  @@index([applicationId, createdAt, id])
  @@index([admissionSource, status, createdAt, id], map: "executions_source_status_created")
  @@map("executions")
  @@schema("control")
}

model DispatchEnvelope {
  id                  String                @id @db.Uuid
  applicationId       String                @map("application_id") @db.Text
  executionBindingId  String                @map("execution_binding_id") @db.Uuid
  executionId         String?               @map("execution_id") @db.Uuid
  profileRevisionId   String                @map("profile_revision_id") @db.Uuid
  inputDigest         String                @map("input_digest") @db.Char(64)
  objectKey           String                @unique @map("object_key") @db.Text
  plaintextSha256     String                @map("plaintext_sha256") @db.Char(64)
  ciphertextSha256    String                @map("ciphertext_sha256") @db.Char(64)
  plaintextBytes      BigInt                @map("plaintext_bytes")
  ciphertextBytes     BigInt                @map("ciphertext_bytes")
  encryptionAlgorithm String                @map("encryption_algorithm") @db.Text
  keyProvider         String                @map("key_provider") @db.Text
  keyReference        String                @map("key_reference") @db.Text
  wrappedDataKey      Bytes                 @map("wrapped_data_key")
  nonce               Bytes                 @db.ByteA
  authenticationTag   Bytes                 @map("authentication_tag") @db.ByteA
  state               DispatchEnvelopeState @default(STAGED)
  revision            Int                   @default(1)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  committedAt         DateTime?             @map("committed_at") @db.Timestamptz(6)
  consumedAt          DateTime?             @map("consumed_at") @db.Timestamptz(6)
  expiresAt           DateTime              @map("expires_at") @db.Timestamptz(6)
  deleteClaimedAt     DateTime?             @map("delete_claimed_at") @db.Timestamptz(6)
  expiredAt           DateTime?             @map("expired_at") @db.Timestamptz(6)

  application ControlApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profile     ProfileRevision    @relation(fields: [profileRevisionId, applicationId], references: [id, applicationId], onDelete: Restrict)
  execution   Execution?         @relation(fields: [executionId, applicationId], references: [id, applicationId], onDelete: Restrict)

  @@unique([executionId, applicationId])
  @@index([state, expiresAt, id], map: "dispatch_envelopes_state_expiry")
  @@index([applicationId, createdAt, id], map: "dispatch_envelopes_application_created")
  @@map("dispatch_envelopes")
  @@schema("control")
}

model Attempt {
  runnerAssignments RunnerAssignment[]
  runnerEvidence    RunnerEvidence[]
  id                String             @id @db.Uuid
  executionId       String             @map("execution_id") @db.Uuid
  ownerInstanceId   String?            @map("owner_instance_id") @db.Uuid
  number            Int
  generation        Int                @default(1)
  status            String             @default("PREPARED")
  authority         String             @default("UNASSIGNED")
  compute           String             @default("NOT_APPLICABLE")
  external          String             @default("NONE")
  execution         Execution          @relation(fields: [executionId], references: [id], onDelete: Restrict)

  observations        UsageObservation[]
  providerInvocations ProviderInvocation[]

  @@unique([id, executionId])
  @@unique([executionId, number])
  @@index([ownerInstanceId])
  @@map("attempts")
  @@schema("control")
}

model ExecutionResult {
  executionId       String    @id @map("execution_id") @db.Uuid
  kind              String
  payload           Json
  provider          String
  model             String
  finishReason      String?   @map("finish_reason")
  providerRequestId String?   @map("provider_request_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  execution         Execution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@map("execution_results")
  @@schema("control")
}

model ProviderInvocation {
  id                String       @id @db.Uuid
  executionId       String       @map("execution_id") @db.Uuid
  attemptId         String       @map("attempt_id") @db.Uuid
  connectionId      String       @map("connection_id") @db.Text
  provider          String
  model             String
  status            String
  requestDigest     String       @map("request_digest") @db.Char(64)
  upstreamRequestId String?      @map("upstream_request_id")
  inputTokens       BigInt?      @map("input_tokens")
  outputTokens      BigInt?      @map("output_tokens")
  errorCode         String?      @map("error_code")
  startedAt         DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(6)
  execution         Execution    @relation(fields: [executionId], references: [id], onDelete: Restrict)
  attempt           Attempt      @relation(fields: [attemptId, executionId], references: [id, executionId], onDelete: Restrict)
  connection        AiConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([executionId, startedAt])
  @@index([connectionId, status])
  @@index([status, startedAt], map: "provider_invocations_status_started")
  @@map("provider_invocations")
  @@schema("control")
}

model Reservation {
  executionId   String    @map("execution_id") @db.Uuid
  accountId     String    @map("account_id")
  originalUnits BigInt    @map("original_units")
  heldUnits     BigInt    @map("held_units")
  postedUnits   BigInt    @default(0) @map("posted_units")
  state         String    @default("RESERVED")
  revision      Int       @default(1)
  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  account BudgetAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@id([executionId, accountId])
  @@map("reservations")
  @@schema("control")
}

model UsageObservation {
  id              String    @id @db.Uuid
  executionId     String    @map("execution_id") @db.Uuid
  attemptId       String    @map("attempt_id") @db.Uuid
  sourceEventId   String    @map("source_event_id")
  sourceRevision  Int       @map("source_revision")
  digest          String    @db.Char(64)
  coverage        String[]
  cumulativeUnits BigInt?   @map("cumulative_units")
  completeness    String
  costBasis       String    @map("cost_basis")
  verification    String
  reason          String
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  execution       Execution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  attempt Attempt       @relation(fields: [attemptId, executionId], references: [id, executionId], onDelete: Restrict)
  entries LedgerEntry[]

  @@unique([id, executionId])
  @@unique([executionId, sourceEventId, sourceRevision])
  @@map("usage_observations")
  @@schema("control")
}

model LedgerEntry {
  id              String    @id @db.Uuid
  executionId     String    @map("execution_id") @db.Uuid
  accountId       String    @map("account_id")
  observationId   String    @map("observation_id") @db.Uuid
  commandId       String    @map("command_id")
  deltaUnits      BigInt    @map("delta_units")
  previousEntryId String?   @map("previous_entry_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  execution       Execution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  reservation Reservation      @relation(fields: [executionId, accountId], references: [executionId, accountId], onDelete: Restrict)
  observation UsageObservation @relation(fields: [observationId, executionId], references: [id, executionId], onDelete: Restrict)
  previous    LedgerEntry?     @relation("adjustment", fields: [previousEntryId, executionId, accountId], references: [id, executionId, accountId], onDelete: Restrict)
  adjustments LedgerEntry[]    @relation("adjustment")

  @@unique([id, executionId, accountId])
  @@unique([accountId, commandId])
  @@map("ledger_entries")
  @@schema("control")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  applicationId String?   @map("application_id")
  topic         String
  aggregateId   String    @map("aggregate_id")
  revision      Int
  payload       Json
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  application ControlApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  receipts    InboxReceipt[]

  @@unique([topic, aggregateId, revision])
  @@map("outbox_events")
  @@schema("control")
}

model InboxReceipt {
  consumer   String
  eventId    String   @map("event_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([consumer, eventId])
  @@map("inbox_receipts")
  @@schema("control")
}

model BudgetProjection {
  accountId String @id @map("account_id")
  revision  Int
  snapshot  Json

  account BudgetAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("budget_projections")
  @@schema("control")
}

model AuditEntry {
  id            String   @id @db.Uuid
  applicationId String?  @map("application_id")
  actor         String
  action        String
  resourceId    String   @map("resource_id")
  revision      Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application ControlApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt, id])
  @@map("audit_entries")
  @@schema("control")
}

model ArtifactMetadata {
  id          String    @id @db.Uuid
  executionId String    @map("execution_id") @db.Uuid
  name        String
  digest      String    @db.Char(64)
  sizeBytes   BigInt    @map("size_bytes")
  mediaType   String    @map("media_type")
  status      String    @default("PENDING")
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@map("artifact_metadata")
  @@schema("control")
}

model RunnerPool {
  id             String @id
  environment    String
  region         String
  minimumVersion String @map("minimum_version")
  status         String @default("ENABLED")
  revision       Int    @default(1)

  nodes RunnerNode[]

  @@map("runner_pools")
  @@schema("control")
}

model RunnerNode {
  assignments     RunnerAssignment[]
  id              String             @id
  ownerSubject    String             @map("owner_subject")
  poolId          String             @map("pool_id")
  version         String
  capabilities    String[]
  connectionIds   String[]           @map("connection_ids")
  capacity        Int
  status          String             @default("RUNNING")
  revision        Int                @default(1)
  lastHeartbeatAt DateTime           @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)

  pool        RunnerPool           @relation(fields: [poolId], references: [id], onDelete: Restrict)
  credentials CredentialInstance[]

  @@map("runner_nodes")
  @@schema("control")
}

/// Claims are uncommitted until mutation + receipt commit together. Expired receipts remain tombstones.
model AdmissionRateWindow {
  scopeKey     String   @map("scope_key") @db.Text
  windowStart  DateTime @map("window_start") @db.Timestamptz(0)
  requestCount Int      @map("request_count")

  @@id([scopeKey, windowStart])
  @@index([windowStart])
  @@map("admission_rate_windows")
  @@schema("control")
}

model ManagementReceipt {
  id            String    @id @db.Uuid
  scopeKey      String    @map("scope_key") @db.Char(64)
  requestKey    String    @map("request_key") @db.VarChar(160)
  operation     String    @db.VarChar(64)
  requestDigest String    @map("request_digest") @db.Char(64)
  response      Json
  completed     Boolean   @default(false)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([scopeKey, requestKey])
  @@index([expiresAt])
  @@map("management_receipts")
  @@schema("control")
}

model RunnerAssignment {
  execution        Execution        @relation(fields: [executionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempt          Attempt          @relation(fields: [attemptId, executionId], references: [id, executionId], onDelete: Restrict, onUpdate: Cascade)
  runner           RunnerNode       @relation(fields: [runnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidence         RunnerEvidence[]
  toolEffects      ToolEffect[]
  id               String           @id @db.Uuid
  executionId      String           @map("execution_id") @db.Uuid
  attemptId        String           @map("attempt_id") @db.Uuid
  runnerId         String           @map("runner_id")
  ownerSubject     String           @map("owner_subject")
  claimBootId      String?          @map("claim_boot_id") @db.Uuid
  leaseNonceDigest String?          @map("lease_nonce_digest") @db.Char(64)
  generation       Int
  epoch            Int
  state            String
  protocolVersion  String           @map("protocol_version")
  proposal         Json?
  proposalDigest   String?          @map("proposal_digest") @db.Char(64)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, executionId, attemptId])
  @@unique([executionId, generation])
  @@index([runnerId, state])
  @@map("runner_assignments")
  @@schema("control")
}

model RunnerEvidence {
  assignment     RunnerAssignment @relation(fields: [assignmentId, executionId, attemptId], references: [id, executionId, attemptId], onDelete: Restrict, onUpdate: Cascade)
  execution      Execution        @relation(fields: [executionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempt        Attempt          @relation(fields: [attemptId, executionId], references: [id, executionId], onDelete: Restrict, onUpdate: Cascade)
  id             String           @id @db.Uuid
  assignmentId   String           @map("assignment_id") @db.Uuid
  executionId    String           @map("execution_id") @db.Uuid
  attemptId      String           @map("attempt_id") @db.Uuid
  sourceEventId  String           @map("source_event_id")
  sourceRevision Int              @map("source_revision")
  digest         String           @db.Char(64)
  payload        Json
  state          String           @default("QUARANTINED")
  receivedAt     DateTime         @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([assignmentId, sourceEventId, sourceRevision])
  @@index([executionId, state])
  @@map("runner_evidence")
  @@schema("control")
}

model RunnerCoordination {
  id        Int      @id
  epoch     Int      @default(1)
  state     String   @default("ACTIVE")
  marker    String?  @db.Uuid
  revision  Int      @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("runner_coordination")
  @@schema("control")
}

model ToolEffect {
  operationId            String           @map("operation_id") @db.Uuid
  applicationId          String           @map("application_id") @db.Text
  executionId            String           @map("execution_id") @db.Uuid
  assignmentId           String           @map("assignment_id") @db.Uuid
  attemptId              String           @map("attempt_id") @db.Uuid
  generation             Int
  epoch                  Int
  toolRef                String           @map("tool_ref") @db.Text
  requestDigest          String           @map("request_digest") @db.Char(64)
  state                  String           @db.Text
  receiptRef             String?          @map("receipt_ref") @db.Text
  receiptDigest          String?          @map("receipt_digest") @db.Char(64)
  receiverRetentionUntil DateTime         @map("receiver_retention_until") @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  execution              Execution        @relation(fields: [executionId, applicationId], references: [id, applicationId], onDelete: Restrict)
  assignment             RunnerAssignment @relation(fields: [assignmentId, executionId, attemptId], references: [id, executionId, attemptId], onDelete: Restrict)

  @@id([applicationId, operationId])
  @@index([executionId, state], map: "tool_effects_execution_state")
  @@map("tool_effects")
  @@schema("control")
}
