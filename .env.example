# M0 has NO provider keys. Local credentials are generated in .local/config.json.
# Optional existing LOCAL database, never a production database:
# DATABASE_URL=postgresql://local_role:local_password@127.0.0.1:54329/ai_runtime_m0
# Optional PostgreSQL binary directory; otherwise pg_config / Windows installation is detected:
# PG_BIN=C:\Program Files\PostgreSQL\15\bin
# Optional Playwright browser channel on Windows (defaults to installed Microsoft Edge):
# PLAYWRIGHT_CHANNEL=msedge
